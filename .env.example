# FloodGuard Environment Configuration
# Copy this file to .env.local to configure your custom keys

# Google Maps JavaScript API Key
# (Optional in Demo Mode. Used for live Google Maps satellite, terrain & vector maps)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Realtime Database Integration (Optional)
# If provided, FloodGuard syncs telemetry, alerts and incident reports with Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Operating Mode: 'demo' (default) or 'live'
VITE_APP_MODE=demo

# Default Monitoring Region
VITE_DEFAULT_COUNTRY=India
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
